@echo off
rem Release build (debug-signed, sideload only). Runs OUTSIDE the DSH sandbox.
set "ROOT=%~dp0"
if "%ROOT:~-1%"=="\" set "ROOT=%ROOT:~0,-1%"
set "LOG=%ROOT%\.tools\build.log"
set "USERPROFILE=%ROOT%\.home"
set "HOME=%ROOT%\.home"
set "APPDATA=%ROOT%\.home\AppData\Roaming"
set "LOCALAPPDATA=%ROOT%\.home\AppData\Local"
set "TEMP=%ROOT%\.home\AppData\Local\Temp"
set "TMP=%TEMP%"
set "GRADLE_USER_HOME=%ROOT%\.home\.gradle"
set "PUB_CACHE=%ROOT%\.pub-cache"
set "PUB_HOSTED_URL=https://pub.flutter-io.cn"
set "FLUTTER_ROOT=%ROOT%\.tools\flutter"
set "JAVA_HOME=%ROOT%\.tools\jdk\jdk-17.0.13+11"
set "ANDROID_HOME=%ROOT%\.tools\android-sdk"
set "ANDROID_SDK_ROOT=%ANDROID_HOME%"
set "ANDROID_USER_HOME=%ROOT%\.home\.android"
set "PATH=%ROOT%\.tools\flutter\bin;%JAVA_HOME%\bin;%ANDROID_HOME%\platform-tools;%PATH%"
if not exist "%TEMP%" mkdir "%TEMP%"
if not exist "%APPDATA%" mkdir "%APPDATA%"
if not exist "%LOCALAPPDATA%" mkdir "%LOCALAPPDATA%"
if not exist "%GRADLE_USER_HOME%" mkdir "%GRADLE_USER_HOME%"
if not exist "%ANDROID_USER_HOME%" mkdir "%ANDROID_USER_HOME%"
cd /d "%ROOT%"
if exist "%ROOT%\build\app\outputs\apk" rmdir /s /q "%ROOT%\build\app\outputs\apk"
if exist "%ROOT%\build\app\outputs\flutter-apk" rmdir /s /q "%ROOT%\build\app\outputs\flutter-apk"
rem 默认按手机（arm64）出包；要别的架构就在命令行后面加参数，例如 br.cmd android-x64
set "ARCH=android-arm64"
if not "%~1"=="" set "ARCH=%~1"
echo ==== START %DATE% %TIME% ==== > "%LOG%"
echo ==== pub get ==== >> "%LOG%"
call flutter pub get >> "%LOG%" 2>&1
echo pubGetExit=%errorlevel% >> "%LOG%"
echo ==== build release apk (%ARCH%) ==== >> "%LOG%"
call flutter build apk --release --target-platform %ARCH% >> "%LOG%" 2>&1
echo buildExit=%errorlevel% >> "%LOG%"
echo ==== END %DATE% %TIME% ==== >> "%LOG%"
if exist "%ROOT%\build\app\outputs\flutter-apk\app-release.apk" (echo APK_OK >> "%LOG%") else (echo APK_MISSING >> "%LOG%")
